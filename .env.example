# ---- This whole file is OPTIONAL ----
# Easiest: start the app (npm start) and connect your provider right in the page
# (Model & settings → Provider base URL + API key → Connect & load models).

# River (default)
RIVER_API_KEY=replace_with_your_river_key
PORT=3000

# ---- Using another OpenAI-compatible provider? (OpenAI, Groq, OpenRouter, Ollama, LM Studio, ...) ----
# Set BASE_URL and API_KEY (instead of the River key). Optionally seed the model dropdown with MODELS.
# BASE_URL=https://api.openai.com/v1
# API_KEY=sk-your-key-here
# MODELS=gpt-5.2,o4-mini
